{
  "permissions": {
    "allow": [
      "Bash(jj st)",
      "Bash(jj st *)",
      "Bash(jj status)",
      "Bash(jj status *)",
      "Bash(jj log)",
      "Bash(jj log *)",
      "Bash(jj diff)",
      "Bash(jj diff *)",
      "Bash(jj show)",
      "Bash(jj show *)",
      "Bash(jj op log)",
      "Bash(jj op log *)",
      "Bash(jj evolog)",
      "Bash(jj evolog *)",
      "Bash(jj workspace list)",
      "Bash(jj workspace list *)",
      "Bash(jj bookmark list)",
      "Bash(jj bookmark list *)",
      "Bash(jj dft)",
      "Bash(jj dft *)"
    ],
    "deny": [
      "Bash(jj *--tool*)",
      "Bash(jj *--config*)"
    ]
  },
  "env": {
    "JJ_EDITOR": "false"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "preferredNotifChannel": "notifications_disabled",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guard-push.sh"
          }
        ]
      }
    ]
  }
}
