% start

# Start feature agent in plan mode
jwc feat/<name> --permission-mode plan

# Start bug fix agent
jwc fix/<name>

# Start ADR agent in plan mode
jwc adr/<name> --permission-mode plan

# Start throwaway spike agent
jwc spike/<name>

# Continue an agent's last conversation
jwc <workspace> --continue

# Drop a spike and remove its workspace
jj abandon 'trunk()..<workspace>@' && jwrm <workspace>

$ workspace: jj --ignore-working-copy workspace list -T 'name ++ "\n"' | grep -vx default | while IFS= read -r w; do d=$(jj --ignore-working-copy log --no-graph --limit 1 -r "heads(::\"$w\"@ & mutable() & ~empty())" -T 'coalesce(description.first_line(), "(no description)")'); printf '%s\t%s\n' "$w" "${d:-(no changes)}"; done --- --column 1 --delimiter '\t'

% agents

# Review agent workspace diff (difftastic)
jj dft -r 'trunk()..<workspace>@'

# Show agent workspace changes and files
jj log -r 'trunk()..<workspace>@' --stat

# Push workspace and open pull request
jpush <bookmark> && gh pr create --head <bookmark> --fill

# Create agent workspaces agent-1..N
for n in $(seq 1 <count>); do (jw "agent-$n"); done

$ workspace: jj --ignore-working-copy workspace list -T 'name ++ "\n"' | grep -vx default | while IFS= read -r w; do d=$(jj --ignore-working-copy log --no-graph --limit 1 -r "heads(::\"$w\"@ & mutable() & ~empty())" -T 'coalesce(description.first_line(), "(no description)")'); printf '%s\t%s\n' "$w" "${d:-(no changes)}"; done --- --column 1 --delimiter '\t'
$ bookmark: jj --ignore-working-copy log --no-graph -r @ -T 'self.working_copies().map(|w| w.name()).join("") ++ "\n"' | grep -vx default
$ count: printf '2\n3\n4\n5\n'

% review

# Review pull request in its own workspace
jj git fetch && jw review-<pr_branch> '<pr_branch>@origin'

# Review agent workspace with a second Claude
jreview <workspace>

# Watch CI checks of pull request
gh pr checks <pr> --watch

$ pr_branch: gh pr list --json headRefName,title --template '{{range .}}{{.headRefName}}{{"\t"}}{{.title}}{{"\n"}}{{end}}' --- --column 1 --delimiter '\t'
$ pr: gh pr list --json number,title --template '{{range .}}{{.number}}{{"\t"}}{{.title}}{{"\n"}}{{end}}' --- --column 1 --delimiter '\t'
$ workspace: jj --ignore-working-copy workspace list -T 'name ++ "\n"' | grep -vx default | while IFS= read -r w; do d=$(jj --ignore-working-copy log --no-graph --limit 1 -r "heads(::\"$w\"@ & mutable() & ~empty())" -T 'coalesce(description.first_line(), "(no description)")'); printf '%s\t%s\n' "$w" "${d:-(no changes)}"; done --- --column 1 --delimiter '\t'
