% go

# Run one Go test
go test <package> -run '^<test>$' -count=1 -v

# Debug one Go test with delve
dlv test <package> -- -test.run '^<test>$'

# Open Go test coverage in the browser
go test -coverprofile=coverage.out ./... && go tool cover -html=coverage.out

$ package: go list ./...
$ test: grep -hoE '^func Test[A-Za-z0-9_]+' "$(go list -f '{{.Dir}}' "$package")"/*_test.go | sed 's/^func //' | sort -u
