% jj

# Describe a change
jj describe -r <change> -m "<message>"

# Rebase stack onto latest trunk
jj git fetch && jj rebase -b @ -o 'trunk()'

# Squash a change into another
jj squash --from <change> --into <target>

# Show a change with difftastic
jj dshow <change>

# Revert a file to its trunk version
jj restore --from 'trunk()' <changed_file>

# Abandon a change
jj abandon <change>

# Find changes that touched a file
jj log -r 'files("<file>")'

# Find changes by description text
jj log -r 'description(substring-i:"<text>")'

# Restore the repo to an earlier operation
jj op restore <operation>

# Check signature of a change
jj --ignore-working-copy log --no-graph -r <change> -T 'if(signature, signature.status() ++ " " ++ signature.display(), "unsigned") ++ "\n"'

# [PERSONAL] Push a change straight to main, no pull request
jland <change>

$ change: jj --ignore-working-copy log --no-graph -r 'mutable()' -T 'change_id.shortest(8) ++ "\t" ++ coalesce(description.first_line(), "(no description)") ++ "\n"' --- --column 1 --delimiter '\t'
$ target: jj --ignore-working-copy log --no-graph -r 'mutable()' -T 'change_id.shortest(8) ++ "\t" ++ coalesce(description.first_line(), "(no description)") ++ "\n"' --- --column 1 --delimiter '\t'
$ changed_file: jj --ignore-working-copy diff --name-only -r 'trunk()..@'
$ file: jj --ignore-working-copy file list
$ operation: jj --ignore-working-copy op log --no-graph --limit 30 -T 'id.short() ++ "\t" ++ description ++ "\n"' --- --column 1 --delimiter '\t'
