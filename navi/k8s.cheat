% k8s

# Tail logs of an app (all its pods)
stern -n <namespace> -l app=<app>

# Debug failing pod (describe, previous logs)
kubectl -n <namespace> describe pod <pod>; kubectl -n <namespace> logs <pod> --previous --all-containers --tail=100

# Port-forward service to localhost
kubectl -n <namespace> port-forward svc/<service> <local_port>:<remote_port>

# Open shell in pod
kubectl -n <namespace> exec -it <pod> -- sh

# Show namespace events, newest last
kubectl -n <namespace> get events --sort-by=.metadata.creationTimestamp

# Show container images in namespace
kubectl -n <namespace> get pods -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.containers[*].image}{"\n"}{end}'

# Decode Kubernetes secret
kubectl -n <namespace> get secret <secret> -o go-template='{{range $k, $v := .data}}{{$k}}={{$v | base64decode}}{{"\n"}}{{end}}'

$ namespace: kubectl get namespaces -o name | sed 's|^namespace/||'
$ pod: kubectl -n "$namespace" get pods --no-headers | awk 'BEGIN { OFS = "\t" } { split($2, r, "/"); line = $1 OFS $3 OFS $2 " ready" OFS $4 " restarts"; if (($3 == "Running" && r[1] == r[2]) || $3 == "Completed") ok = ok line "\n"; else print line } END { printf "%s", ok }' --- --column 1 --delimiter '\t'
$ app: kubectl -n "$namespace" get pods -o jsonpath='{range .items[*]}{.metadata.labels.app}{"\n"}{end}' | sort -u
$ service: kubectl -n "$namespace" get services -o name | sed 's|^service/||'
$ remote_port: kubectl -n "$namespace" get service "$service" -o jsonpath='{range .spec.ports[*]}{.port}{"\n"}{end}'
$ secret: kubectl -n "$namespace" get secrets -o name | sed 's|^secret/||'
